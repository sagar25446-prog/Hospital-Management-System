# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/hospital_db
DATABASE_URL=postgresql://localhost:5432/hospital_db

# JWT secrets (use long random strings in production)
JWT_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret

# Google OAuth ("Sign in with Google")
# Get this from Google Cloud Console > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend .env exactly.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Razorpay (online payments)
# Get these from the Razorpay Dashboard > Settings > API Keys.
# Use the rzp_test_... keys while developing; switch to rzp_live_... in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard > Settings > Webhooks > Add New Webhook.
# URL: https://your-api-domain.com/api/v1/payments/webhook
# Events to subscribe to: payment.captured
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: server port (default 3000)
# PORT=3000
