# API base URL (optional; Vite proxy uses /api -> backend when empty)
VITE_API_URL=

# Google OAuth Client ID ("Sign in with Google" button)
# Must be the SAME client ID as backend's GOOGLE_CLIENT_ID.
# Get it from Google Cloud Console > APIs & Services > Credentials.
# Add this app's URL (e.g. http://localhost:5173 and your deployed domain)
# under "Authorized JavaScript origins" on that OAuth client.
VITE_GOOGLE_CLIENT_ID=

# Note: no Razorpay key is needed here — the backend's create-order response
# already includes the public key_id, so it can't drift out of sync with the
# server that actually owns the secret.
